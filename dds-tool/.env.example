# Airtable REST API key — used server-side only (src/app/api/vendor-mapping, src/app/api/classify-reason)
AIRTABLE_API_KEY=

# Airtable base ID for the "1st Mile Data" base (value used in production: appC7tN7h8yeftyVV)
AIRTABLE_BASE_ID=

# Anthropic API key — yes, this is really the variable name in Vercel. Used by
# src/app/api/classify-reason to call Claude Haiku for loss-reason classification.
controltower=
